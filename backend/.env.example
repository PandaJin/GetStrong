# App
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/getstrong

# Kimi (Moonshot AI) - 国内用户
KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-128k-vision

# Gemini (Google AI) - 海外用户
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Alibaba Cloud OSS
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET_NAME=getstrong-images
OSS_CDN_DOMAIN=cdn.getstrong.cn
OSS_STS_ROLE_ARN=acs:ram::xxx:role/oss-upload-role

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
